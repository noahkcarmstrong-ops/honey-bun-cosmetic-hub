{
  "manifest_version": 3,
  "name": "Roblox 2016 Classic",
  "version": "1.18.47",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:38261/*"
  ],
  "background": {
    "service_worker": "larpbux-game-background.js"
  },
  "description": "Choose classic 2016 or current Roblox appearance while keeping Larpblox cosmetics and game sync.",
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "css": [
        "era-layout.css",
        "classic.css",
        "classic-icons.css",
        "classic-avatar.css",
        "classic-home-games.css",
        "classic-catalog.css",
        "classic-item.css",
        "larpbux.css"
      ],
      "js": [
        "identity-gate.js",
        "appearance.js",
        "classic.js",
        "classic-avatar.js",
        "classic-avatar-menu.js",
        "classic-home.js",
        "classic-home-games.js",
        "classic-quick-play.js",
        "classic-catalog.js",
        "modern-catalog-sort.js",
        "classic-item.js",
        "classic-groups.js",
        "larpbux-avatar-3d.js",
        "larpbux-game-bridge.js",
        "larpbux-avatar-surfaces.js",
        "larpbux-profile-wearing.js",
        "larpbux-names.js",
        "larpbux-characters.js",
        "larpbux.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/larpblox-logo.png",
        "assets/source-sans-pro-*.woff2",
        "assets/robux-classic*.svg",
        "assets/builders-club.png",
        "assets/builders-club-outline.svg",
        "assets/limited-classic.png",
        "assets/limited-unique-classic.png"
      ],
      "matches": [
        "https://www.roblox.com/*"
      ]
    }
  ]
}
